                  "function wordsToB64url(w) { return CryptoJS.enc.Base64.stringify(w).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_'); }",
                  "function strToB64url(str) { return wordsToB64url(CryptoJS.enc.Utf8.parse(str)); }",
                  "const parts = (pm.collectionVariables.get('access') || '').split('.');",
                  "if (parts.length !== 3) { throw new Error('Run \"Login (success)\" first so {{access}} is set.'); }",
                  "const [h, p, s] = parts;",
                  "const claims = JSON.parse(b64urlToStr(p));",
                  "const first = s[0] === 'A' ? 'B' : 'A';",
                  "pm.collectionVariables.set('tampered_access', [h, p, first + s.slice(1)].join('.'));"
