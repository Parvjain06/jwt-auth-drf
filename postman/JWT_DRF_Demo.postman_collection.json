                  "const CryptoJS = require('crypto-js');",
                  "function b64urlToStr(s) { s = s.replace(/-/g, '+').replace(/_/g, '/'); while (s.length % 4) s += '='; return CryptoJS.enc.Base64.parse(s).toString(CryptoJS.enc.Utf8); }",
                  "function wordsToB64url(w) { return CryptoJS.enc.Base64.stringify(w).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_'); }",
                  "function strToB64url(str) { return wordsToB64url(CryptoJS.enc.Utf8.parse(str)); }",
                  "const parts = (pm.collectionVariables.get('access') || '').split('.');",
                  "if (parts.length !== 3) { throw new Error('Run \"Login (success)\" first so {{access}} is set.'); }",
                  "const [h, p, s] = parts;",
                  "const claims = JSON.parse(b64urlToStr(p));",
                  "claims.exp = claims.exp + 365 * 24 * 3600;             // try to make the token last a year",
                  "pm.collectionVariables.set('tampered_access', [h, strToB64url(JSON.stringify(claims)), s].join('.'));"
                ]
              }
