    {
      "name": "6. Login throttling (run with Collection Runner, 6+ iterations)",
      "item": [
        {
          "name": "Brute-force attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "description": "Run this request 6+ times. The limit is 5 login attempts per minute per IP (earlier logins in the same minute count too), so later attempts return 429 with a Retry-After header.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"guess-{{$randomInt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 while under the limit, 429 once over it\", function () {",
                  "  pm.expect([401, 429]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 429) { console.log('Throttled. Retry-After:', pm.response.headers.get('Retry-After')); }"
                ]
              }
            }
          ]
        }
      ]
