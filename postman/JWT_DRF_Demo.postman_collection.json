{
  "info": {
    "name": "JWT Authentication in DRF — Demo",
    "description": "Demonstrates SimpleJWT login, refresh-token rotation, logout with blacklisting, tampered/expired token rejection, the protected Dog API endpoint, and Django session authentication for comparison. Run folders in order. Folder 6 triggers the login throttle, so run it last.\n\nSetup: `python manage.py create_demo_user` then `python manage.py runserver`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login",
      "item": [
        {
          "name": "Login (success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "description": "Logs in and stores {{access}} (5 min) and {{refresh}} (1 day) in collection variables.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "",
                  "const data = pm.response.json();",
                  "pm.test(\"Returns access and refresh tokens\", function () { pm.expect(data).to.have.keys('access', 'refresh'); });",
                  "pm.collectionVariables.set('access', data.access);",
                  "pm.collectionVariables.set('refresh', data.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (wrong password)",
          "request": {
            "method": "POST",
