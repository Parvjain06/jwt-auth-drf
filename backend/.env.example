# Copy this file to .env and fill in real values. Never commit .env.
# Generate keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HS256 signing key for JWTs. Must be at least 32 characters and must be
# different from DJANGO_SECRET_KEY, so each can be rotated independently.
JWT_SIGNING_KEY=replace-with-a-different-long-random-string

# The Dog API key (https://thedogapi.com). Kept on the server only.
# The API also answers without a key, with lower limits.
DOG_API_KEY=

# Login attempts allowed per client IP (DRF rate format: N/sec|min|hour|day)
LOGIN_THROTTLE_RATE=5/min
